# Database Configurations
# For local development, leave these blank to default to packages/db/local.db
# For staging/production, provide your Turso database credentials
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# API Server Configurations
PORT=3000
LOG_LEVEL=info

# JWT and Authentication
JWT_SECRET=your-super-secret-jwt-key-replace-in-production
COOKIE_SECRET=your-super-secret-cookie-key-replace-in-production

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
